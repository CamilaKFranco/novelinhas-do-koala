{
  "urlInicio": "https://app.leonardo.ai/",
  "urlEditorVideo": "https://app.leonardo.ai/generate",
  "textos": {
    "login": "Log in|Sign in|Entrar",
    "gerar": "Generate|Gerar",
    "tituloPainelReferencia": "^\\s*Reference\\s*$|^\\s*Image Input\\s*$",
    "cartaoReferenciaImagem": "Image Reference",
    "cartaoStartFrame": "Start frame",
    "abaVideo": "Video",
    "tituloSelecaoMidia": "Select Media",
    "abaUploads": "Your Uploads",
    "uploadImagem": "Upload an image",
    "selecionados": "(\\d+)\\s*/\\s*(\\d+)\\s*selected",
    "confirmar": "Confirm"
  },
  "seletores": {
    "prompt": "textarea:visible, [contenteditable='true']:visible",
    "botaoReferencias": "button[data-tracking-id='generation_add_image_guidance_element'], button[aria-label*='Add reference' i]",
    "itemMidia": "[role='article']",
    "miniaturaReferencia": "div[data-slot='prompt-thumbnails'] img",
    "itemSelecionado": "[role='article'] button[aria-label='Select'][aria-pressed='true']",
    "parametroReferenciasUrl": "imageGuidance"
  },
  "configuracao": [
    {
      "campo": "modelo",
      "tipo": "menu",
      "abrir": "Model",
      "opcao": "{valor}"
    },
    {
      "campo": "duracao",
      "tipo": "slider",
      "rotulo": "Duration"
    },
    {
      "campo": "modo",
      "tipo": "botao",
      "opcao": "{valor}"
    },
    {
      "campo": "proporcao",
      "tipo": "botao",
      "opcao": "{valor}"
    },
    {
      "campo": "resolucao",
      "tipo": "botao",
      "opcao": "{valor}"
    }
  ],
  "tempos": {
    "esperaAposCarregarMs": 6000,
    "maximoGeracaoMs": 900000,
    "pausaEntreCenasMs": [
      20000,
      45000
    ]
  },
  "tentativasPorCena": 3,
  "qualidade": {
    "toleranciaDuracaoS": 2,
    "maxProporcaoPreta": 0.5,
    "tamanhoMinimoKB": 100
  }
}